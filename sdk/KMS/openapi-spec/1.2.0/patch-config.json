{
  "input": "security-encryption-api.yaml",
  "patches": [
    {
      "type": "remove-format",
      "format": "uri"
    },
    {
      "type": "remove-format",
      "format": "iso8601"
    },
    {
      "type": "add-format",
      "format": "date-time",
      "namePattern": "^DateTime$",
      "targetType": "string"
    },
    {
      "type": "simplify-allof"
    },
    {
      "type": "extract-inline-schemas",
      "errorSchemaName": "Error"
    }
  ]
}
